{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "reference/**",
      "tools/**",
      "progress/**",
      "review/**",
      "*.md",
      "package*.json",
      "firebase-debug.log"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "assets/**/*.@(glb|ogg|m4a|png|jpg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "_note": "Production is GitHub Pages at bureau.gzowo.fun (the gzowo.fun wildcard already points there, so it needs no DNS record). This Firebase Hosting site is kept only as a throwaway staging mirror; deploy it with `firebase deploy --only hosting`."
  },
  "database": {
    "rules": "database.rules.json"
  }
}